# Copy to .env and fill in GEMINI_API_KEY (never commit .env)

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Local backend (H2 file DB — no Docker required)
SERVER_PORT=8080

# Production / Railway Postgres (used when SPRING_PROFILES_ACTIVE=prod)
# POSTGRES_DB=medwise
# POSTGRES_USER=medwise
# POSTGRES_PASSWORD=medwise
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Frontend
API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
